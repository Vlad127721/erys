{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "express",
      "runtime": "nodejs24.x",
      "installCommand": "cd ../.. && npm ci",
      "buildCommand": "bash ../../scripts/vercel-build-api.sh",
      "entrypoint": "dist/vercel.js"
    },
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "cd ../.. && npm ci",
      "buildCommand": "cd ../.. && npm run build -w @youscan/shared && npm run build -w @youscan/web",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
