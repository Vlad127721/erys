# Web environment. Copy to `.env.local` (git-ignored) only if you need to override.
# Everything prefixed with VITE_ is embedded in the public JS bundle: never put secrets here.

# API origin. Leave empty when the API is served from the same domain under /api (on Vercel,
# and in development, where Vite proxies /api to http://localhost:3000).
VITE_API_URL=
