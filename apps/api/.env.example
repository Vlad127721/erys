# API environment. Copy to `.env` (git-ignored) and adjust. Real environment variables
# take precedence over this file, so in production set them in the hosting dashboard
# instead of shipping a .env file.

# --- Required ---------------------------------------------------------------

# PostgreSQL used by the app. The defaults match docker-compose.yml.
# Neon: use the *pooled* connection string here.
DATABASE_URL="postgresql://youscan:youscan@localhost:5432/youscan"

# --- Optional ---------------------------------------------------------------

# Direct (non-pooled) connection for `prisma migrate`. Needed only when DATABASE_URL
# points to a pooler (e.g. Neon); falls back to DATABASE_URL_UNPOOLED (set by Vercel's Neon
# integration), then to DATABASE_URL.
# DIRECT_URL="postgresql://..."

# HTTP port. Default: 3000.
PORT=3000

# Largest accepted upload for POST /api/import, in bytes (max 52428800 = 50 MiB).
# Default: 5242880 (5 MiB). On Vercel use 4194304: function request bodies are capped at 4.5 MB.
MAX_UPLOAD_SIZE_BYTES=5242880

# Seed manifest path. Default: data/seed-manifest.json in the repository.
# SEED_MANIFEST="/path/to/seed-manifest.json"

# --- Tests ------------------------------------------------------------------

# A separate, disposable database: integration tests DELETE all its data. Must differ
# from DATABASE_URL (enforced). Without it, database test suites are skipped.
TEST_DATABASE_URL="postgresql://youscan:youscan@localhost:5432/youscan_test"
